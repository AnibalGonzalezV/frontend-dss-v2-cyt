# ==============================================================================
# DSS Vendimia - Frontend Environment Variables (Next.js 16)
# ==============================================================================
# En desarrollo local: si este archivo no se define, el sistema asume
# automaticamente "http://localhost:8080/api/v1".
#
# Para despliegues en produccion o pruebas en Vercel con un tunel HTTPS:
# NEXT_PUBLIC_API_URL=https://tu-api.tudominio.com/api/v1

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
